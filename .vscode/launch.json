{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": ".",
      "program": "${workspaceRoot}/build/output/InputBridge",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      // Default path for Linux (CachyOS)
      "miDebuggerPath": "/usr/bin/gdb",
      
      // Windows-specific overrides
      "windows": {
          "program": "${workspaceFolder}/build/output/Release/InputBridge.exe",
          "MIMode": "gdb", 
          "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe" 
      },
      
      "preLaunchTask": "CMake: build"
    }
  ]
}