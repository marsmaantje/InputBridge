{
    "cmake.configureArgs": [
        "-DBUILD_TESTS=ON"
    ],
    "sonarlint.pathToCompileCommands": "${workspaceFolder}/build/compile_commands.json",
    "testMate.cpp.test.executables": "${workspaceFolder}/build/**/test_*",
    "testMate.cpp.test.advancedExecutables": [
        {
            "pattern": "${workspaceFolder}/build/**/test_*{.exe,}",
            "cwd": "${workspaceFolder}"
        }
    ],
    "testMate.cpp.log.logpanel": true
}