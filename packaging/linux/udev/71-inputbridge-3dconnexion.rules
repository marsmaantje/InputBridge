# InputBridge - udev rules for 3Dconnexion 6-DOF devices (SpaceNavigator,
# SpaceMouse, SpacePilot, ...). Grants the logged-in desktop user read access
# to the hidraw node so InputBridge can read the device passively.
#
# This does NOT take the device away from 3DxWare / spacenavd: hidraw nodes
# can be opened by any number of readers, each receiving every report. It only
# adds access; it changes nothing for drivers that already work.
#
# Keep the "71" prefix (must sort BEFORE systemd's 73-seat-late.rules, or the
# uaccess tag is applied too late) - see 71-inputbridge-wiimote.rules for the
# full explanation. TAG and GROUP are separate lines for the same reason as
# there: a missing "plugdev" group invalidates only the GROUP line.
#
# Install manually (the in-app "Fix permissions" button only handles the
# Wii rules file):
#   sudo cp 71-inputbridge-3dconnexion.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger --subsystem-match=hidraw
# then replug the device.

# 3Dconnexion vendor ID
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="256f", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="256f", GROUP="plugdev", MODE="0660"

# Logitech-era 3Dconnexion devices: matched by PID only (never the whole
# Logitech vendor): c603 c605 c606 c621 c623 c625 c626 c627 c628 c629 c62b
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c603|c605|c606|c621|c623|c625|c626|c627|c628|c629|c62b", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c603|c605|c606|c621|c623|c625|c626|c627|c628|c629|c62b", GROUP="plugdev", MODE="0660"
