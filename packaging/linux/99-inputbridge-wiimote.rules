# InputBridge - udev rules for Nintendo Wii Remote / Wii Balance Board
#
# Without this file, a Wiimote or Balance Board connected via a Bluetooth
# *dongle* (as opposed to a laptop's built-in adapter on some distros) is
# commonly exposed as a plain hid-generic device backed by the kernel's
# uhid subsystem, and the resulting /dev/hidraw* node is created
# root:root with mode 0600 - readable/writable only by root - because no
# rule tags it for the desktop user's session otherwise. InputBridge talks
# to these devices over hidraw (see WiimoteManager.cpp), so without a rule
# like this one it fails to open the node with EACCES.
#
# This rule matches Nintendo's USB vendor ID (057e) and the two product
# IDs Wiimotes and Wii Remote Plus / Balance Boards report (0306, 0330 -
# the Balance Board shares 0330 with the Wiimote Plus; the two are told
# apart at the protocol level, not by PID, so both must be covered here).
# It grants access two ways so it works whether or not the local distro
# defines/uses a "plugdev" group:
#   1. TAG+="uaccess" - the systemd-logind/udev mechanism most modern
#      distros (Fedora, Arch, recent Debian/Ubuntu, etc.) use to grant the
#      currently logged-in seat's user access automatically, no group
#      membership required.
#   2. GROUP="plugdev", MODE="0660" - a fallback for older/minimal distros
#      that still rely on plugdev-style group ownership instead of uaccess.
#      Harmless if plugdev doesn't exist; uaccess (1) covers those systems.

# Wiimote (RVL-CNT-01) and Wiimote Plus / Balance Board (RVL-CNT-01-TR),
# connected via USB Bluetooth dongle or built-in adapter.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="0306", TAG+="uaccess", GROUP="plugdev", MODE="0660"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="0330", TAG+="uaccess", GROUP="plugdev", MODE="0660"

# Some Bluetooth stacks surface the vendor/product IDs on the parent
# Bluetooth HID device node rather than (or in addition to) the hidraw
# grandchild's own ATTRS. Walking up to match there too covers dongles
# whose hidraw node doesn't inherit idVendor/idProduct directly.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{name}=="Nintendo RVL-CNT-01", TAG+="uaccess", GROUP="plugdev", MODE="0660"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{name}=="Nintendo RVL-CNT-01-TR", TAG+="uaccess", GROUP="plugdev", MODE="0660"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{name}=="Nintendo RVL-WBC-01", TAG+="uaccess", GROUP="plugdev", MODE="0660"
